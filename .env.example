# api for general natural-language planning; demo for offline prefix examples
LLM_MODE=api
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
TAVILY_API_KEY=
# Use /app/data in Docker; use ./data for local Python runs
DATA_DIR=/app/data
TOOL_TIMEOUT=5
LLM_TIMEOUT=30
MAX_ATTEMPTS=3
MAX_REPLANS=2
MAX_TOOL_CALLS=40
BACKOFF_BASE=0.25
BACKOFF_CAP=4
# Set a long random token before exposing the API publicly
API_TOKEN=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=resilient-agent
PORT=8000
